# Meta (Facebook) Pixel — see .claude/Rule/meta-pixel-tracking.md
#
# Both vars are required. With either missing the pixel renders nothing
# and every helper is a no-op — that is the correct disabled state, not
# a bug.
#
# NEXT_PUBLIC_* values are inlined at BUILD time, so restart the dev
# server after changing them; a hot reload is not enough.
#
# These are public by design (a pixel ID is visible in page source) and
# are not secrets, but they still belong in env so staging and
# production can differ.

# Numeric pixel ID from Meta Events Manager.
NEXT_PUBLIC_META_PIXEL_ID=

# Compared to the literal string 'true'. Any other value (1, TRUE,
# unset) disables the pixel.
NEXT_PUBLIC_META_PIXEL_ENABLED=false

# Stripe — shop checkout (/api/checkout) and payment webhook
# (/api/webhooks/stripe). Use sk_test_/pk_test_ keys locally and on staging;
# live keys only in production.
#
# STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are server-only — never give
# them a NEXT_PUBLIC_ prefix.

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# From the webhook endpoint registered in the Stripe dashboard. Locally, run
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` and use the
# whsec_ it prints instead.
STRIPE_WEBHOOK_SECRET=

# Public origin used for Stripe success/cancel redirect URLs. Falls back to
# the request origin when unset (fine for local dev).
NEXT_PUBLIC_SITE_URL=https://www.northwestoregon.com

# Optional: GHL inbound webhook that receives a paid-order summary from
# /api/webhooks/stripe. Leave blank to skip the fan-out.
GHL_ORDER_WEBHOOK=

# Optional: dedicated GHL inbound webhook for the HD27 (Mark Norman vs Tammy
# Carpenter) voter-guide funnel. Falls back to the default contact webhook.
GHL_HD27_WEBHOOK=
